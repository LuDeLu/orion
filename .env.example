# --- Google Apps Script Webhook (ver scripts/sheets-webhook.gs) ---
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
SHEETS_WEBHOOK_SECRET=cambiar-por-un-string-largo-y-aleatorio

# --- Admin /admin (login custom con HMAC) ---
ADMIN_USER=UsuarioAdmin
ADMIN_PASS=cambiar-por-password-fuerte

# Opcional: si no se setea, se usa ADMIN_PASS como clave para firmar la cookie.
# Recomendado: setearlo aparte para poder rotar el password sin invalidar la firma anterior.
ADMIN_SESSION_SECRET=otro-string-largo-y-aleatorio-para-firmar-sesiones

# --- Portal del cliente de Mintaka (/it/seguimiento, /it/presupuesto, /it/entrar) ---
# URL de la API de Mintaka (el backend del área IT). El fetch lo hace el server
# de Next, así que esta URL nunca sale al navegador ni hace falta abrir CORS.
# Desarrollo: http://localhost:4000 · Producción: el dominio donde la publiques.
MINTAKA_API_URL=http://localhost:4000

# --- Facturación ARCA (/admin/facturacion) ---
# Base de datos: Upstash Redis desde el Marketplace de Vercel (crea estas dos solas).
# Sin ellas, en local se usa .data/facturacion.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# CUIT emisor (lo bloquea en el panel). Entorno inicial y punto de venta: editables en el panel.
ARCA_CUIT=20468137934
ARCA_ENTORNO=homologacion
ARCA_PUNTO_VENTA=1
# Opcional: clave para cifrar la clave privada guardada desde el panel (si no, usa ADMIN_SESSION_SECRET).
# Si la cambiás, hay que volver a cargar el certificado.
ARCA_SECRET=
# Opcional: certificado y clave por variables (PEM o base64). Si están, tienen prioridad sobre el panel.
ARCA_CERT=
ARCA_KEY=
